{
  "name": "tools",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:db": "bun scripts/dev-db.ts",
    "migrate": "bun scripts/migrate.ts",
    "build": "bun scripts/check-skills.ts && bun scripts/check-style.ts && bun scripts/hairline.ts --check && vite build",
    "typecheck": "tsc --noEmit",
    "check:skills": "bun scripts/check-skills.ts",
    "check:style": "bun scripts/check-style.ts",
    "verify:webhooks": "bun scripts/verify-webhooks.ts",
    "hairline": "bun scripts/hairline.ts",
    "icons": "bun scripts/icons.ts",
		"new-tool": "bun scripts/new-tool.ts",
		"land": "bun scripts/land.ts",
    "deploy": "bun run build && wrangler deploy",
    "preview": "bun run build && wrangler preview",
    "test": "bun test ./worker ./tools ./src ./scripts"
  },
  "packageManager": "bun@1.4.5",
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@hugeicons/core-free-icons": "4.4.0",
    "@hugeicons/react": "1.1.10",
    "@modelcontextprotocol/sdk": "1.32.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.1",
    "@electric-sql/pglite": "0.5.17",
    "@openweight/sdk": "0.13.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/bun": "^1.4.5",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "wrangler": "4.166.0"
  }
}
