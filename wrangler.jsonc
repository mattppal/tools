{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tools",
	"main": "worker/index.ts",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"preview_urls": true,
	"routes": [{ "pattern": "tools.mattpalmer.io", "custom_domain": true }],
	"assets": {
		"binding": "ASSETS",
		"run_worker_first": ["/api/*", "/", "/index.html"]
	},
	"hyperdrive": [
		{
			"binding": "DB",
			"id": "1fce713944994e84ada0aefed7e29dec",
			"localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5432/postgres"
		}
	],
	"previews": {
		"hyperdrive": [{ "binding": "DB", "id": "e848bceaf6914abb931f40d0e3c65c54" }],
		"version_metadata": { "binding": "CF_VERSION_METADATA" }
	},
	"version_metadata": { "binding": "CF_VERSION_METADATA" },
	"triggers": { "crons": ["* * * * *"] },
	"observability": { "enabled": true, "logs": { "enabled": true } }
}
